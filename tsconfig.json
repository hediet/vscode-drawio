{
	"compilerOptions": {
		"module": "commonjs",
		"target": "es6",
		"outDir": "out",
		"lib": ["es6"],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,
		// The types of playwright-core name the classes of the DOM, which the extension does not load.
		"skipLibCheck": true,
		"experimentalDecorators": true
	},
	"include": ["./src/**/*", "./drawio-custom-plugins/src/types.d.ts"],
	// Browser bundle with its own tsconfig (DOM lib, bundler resolution).
	"exclude": ["./src/codeblock-editor/guest"]
}
